# Ignore Visual Studio temporary files, build results, and
# user-specific files
*.obj
*.exe
*.pdb
*.user
*.aps
*.pch
*.vspscc
*.vssscc
*.cache
*.ilk
*.log
*.suo
*.ncb
*.sdf
*.opendb
*.VC.db

# Ignore Visual Studio Code workspace settings
.vscode/

# Ignore build output folders
[Bb]in/
[Oo]bj/

# Ignore NuGet Packages
*.nupkg
**/packages/*
!**/packages/build/
!**/packages/repositories.config

# Windows specific files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Ignore logs, databases, and other runtime files
*.log
*.db
*.db-journal
*.sqlite

# Ignore Visual Studio working files
.vs/
Release/
x64/
bin/

# Ignore crash reports and debug files
*.stackdump

# Ignore Installer files
*.msi
*.cab
*.msm
*.msp

# Ignore additional files generated by Visual Studio
*.tlog
*.lastbuildstate
*.idb
*.ipch
